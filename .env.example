# SID-SED — variáveis de ambiente
# Copie este arquivo para .env.local e ajuste os valores.

# Modo demonstração (login local sem Supabase)
# true = usa usuários fictícios e cookie de sessão
NEXT_PUBLIC_DEMO_MODE=true

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (obrigatório quando NEXT_PUBLIC_DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# Apenas para scripts de seed (nunca exponha no cliente)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
